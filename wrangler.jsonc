{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artsnet-mcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Uncomment and adjust to serve at a custom domain owned by the deploying account:
  // "routes": [{ "pattern": "mcp.artsnet.com", "custom_domain": true }],
  "vars": {
    "ARTSNET_API_BASE": "https://artsnet.com/api/v1"
  }
}
